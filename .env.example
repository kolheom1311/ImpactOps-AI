# ==============================================================================
# ImpactOps AI — Safe Environment Configuration Template
# ==============================================================================
# SECURITY NOTICE:
# - Never commit actual API keys, private credentials, or secrets to Git.
# - Copy this file to '.env' for local development:
#     PowerShell:  Copy-Item .env.example .env
#     Bash/macOS:  cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=3001
HOST=127.0.0.1

# ------------------------------------------------------------------------------
# Google Gemini AI Integration (Optional)
# ------------------------------------------------------------------------------
# ImpactOps AI functions seamlessly out of the box without an API key using its
# built-in Deterministic Mathematical Rule Engine as a verified fallback.
#
# To enable live reasoning with Google Gemini:
# 1. Obtain an API key from Google AI Studio (https://aistudio.google.com/)
# 2. Set your key below (e.g. GEMINI_API_KEY=AIzaSy...)
# 3. Leave blank to operate in transparent deterministic fallback mode.
GEMINI_API_KEY=

# Supported Gemini Model: gemini-1.5-flash (recommended) or gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Operational Simulation Parameters
# ------------------------------------------------------------------------------
# Flag indicating that telemetry streams are generated synthetic datasets (true/false)
ENABLE_SIMULATED_STREAM=true

# Default facility to load on initial launch:
# Options:
#   - fac-dc-north   (North Data Center — Ashburn, VA)
#   - fac-mfg-austin (Austin Advanced Manufacturing — Austin, TX)
#   - fac-hq-seattle (HQ Innovation Campus — Seattle, WA)
DEFAULT_FACILITY=fac-dc-north
